generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Best lap times — persisted across sessions
model LapRecord {
  id          String   @id @default(cuid())
  playerName  String
  lapTimeMs   Int
  mode        String   // "quick" | "trial" | "online"
  carColor    String   @default("#f59e0b")
  carId       String?  // registry id (src/game/cars/registry.ts) — null = legacy row / procedural
  mapId       String?  // registry id (src/game/maps/registry.ts) — null = legacy row
  createdAt   DateTime @default(now())

  @@index([lapTimeMs])
  @@index([mode, lapTimeMs])
  @@index([mapId, lapTimeMs])
}
